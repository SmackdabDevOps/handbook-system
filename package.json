{
  "name": "@smackdab/handbook-system",
  "version": "0.1.0",
  "description": "Portable API-First TDD methodology with full orchestration and validation infrastructure",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "handbook-init": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:cli": "ncc build bin/handbook-init.ts -o dist/cli --minify",
    "test": "jest",
    "prepublishOnly": "npm run build && npm run build:cli"
  },
  "keywords": ["tdd", "api-first", "validation", "handbook", "methodology"],
  "author": "Smackdab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smackdab/handbook-system.git"
  },
  "files": ["dist/", "core/", "optional/", "stacks/", "validation/", "claude/", "husky/", "plugin/", "scaffolds/"],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.7.0"
  }
}
