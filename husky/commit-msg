#!/bin/sh
# =============================================================================
# Commit Message Hook - Validation Freshness Check
# =============================================================================
# Template for handbook-system projects
# Generated by @smackdab/handbook-system - customize paths in handbook.config.json
#
# This hook validates that commits include fresh validation results.
# It prevents committing stale validation artifacts.
#
# To bypass (emergency only): git commit --no-verify
#
# See handbook/cicd/PRE_COMMIT_HOOKS.md for full documentation.
# =============================================================================

echo "📋 Checking validation freshness..."

# Path configured via handbook.config.json
# Default: scripts/validation/check-registry-freshness.ts
FRESHNESS_CHECK_PATH="${FRESHNESS_CHECK_PATH:-scripts/validation/check-registry-freshness.ts}"

npx ts-node "$FRESHNESS_CHECK_PATH"

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ COMMIT BLOCKED - Validation results are stale"
  echo ""
  echo "Run validators before committing:"
  echo "  npm run validation:quick"
  echo ""
  exit 1
fi

echo "✅ Validation freshness check passed"
