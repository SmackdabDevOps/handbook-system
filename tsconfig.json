{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "bin/**/*",
    "core/**/*",
    "optional/**/*",
    "stacks/**/*",
    "validation/**/*",
    "claude/**/*",
    "husky/**/*",
    "plugin/**/*",
    "scaffolds/**/*"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
